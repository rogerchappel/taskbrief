{
  "name": "taskbrief",
  "version": "0.1.0",
  "description": "Turn messy brain dumps into agent-ready task queues.",
  "type": "module",
  "bin": {
    "taskbrief": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "skills",
    "templates",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsup",
    "cli": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node dist/cli.js --help && node dist/cli.js --version && node dist/cli.js parse examples/voice-dump.txt --format json >/tmp/taskbrief-smoke.json && node -e \"const fs=require('node:fs'); const data=JSON.parse(fs.readFileSync('/tmp/taskbrief-smoke.json','utf8')); if (!Array.isArray(data.tasks) || data.tasks.length === 0) process.exit(1);\"",
    "package:smoke": "bash scripts/package-smoke.sh",
    "release:check": "npm run typecheck && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agents",
    "cli",
    "task-planning",
    "codex",
    "crewcmd"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/taskbrief.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/taskbrief/issues"
  },
  "homepage": "https://github.com/rogerchappel/taskbrief#readme"
}
